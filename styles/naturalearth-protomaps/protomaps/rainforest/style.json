{
  "version": 8,
  "name": "openstreetmap protomaps rainforest",
  "sources": {
    "naturalearth-protomaps": {
      "type": "vector",
      "url": "https://v1.maps.black/naturalearth-protomaps/{z}/{x}/{y}.pbf"
    }
  },
  "sprite": "https://v1.maps.black/styles/naturalearth-protomaps/protomaps/rainforest/sprites/rainforest/sprites",
  "glyphs": "https://v1.maps.black/fonts-minimal/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {"background-color": "rgba(231, 240, 221, 1)"}
    },
    {
      "id": "earth",
      "type": "fill",
      "source": "naturalearth-protomaps",
      "source-layer": "earth",
      "filter": [
        "match",
        ["geometry-type"],
        ["MultiPolygon", "Polygon"],
        true,
        false
      ],
      "paint": {"fill-color": "rgba(230, 203, 177, 1)"}
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "naturalearth-protomaps",
      "source-layer": "landcover",
      "paint": {
        "fill-color": [
          "match",
          ["get", "kind"],
          "grassland",
          "rgba(147, 163, 53, 1)",
          "barren",
          "rgba(204, 183, 62, 1)",
          "urban_area",
          "rgba(182, 38, 25, 1)",
          "farmland",
          "rgba(57, 130, 75, 1)",
          "glacier",
          "rgba(255, 255, 255, 1)",
          "scrub",
          "rgba(93, 80, 26, 1)",
          "rgba(29, 75, 76, 1)"
        ],
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 5, 1, 7, 0]
      }
    },
    {
      "id": "landuse_park",
      "type": "fill",
      "source": "naturalearth-protomaps",
      "source-layer": "landuse",
      "filter": [
        "match",
        ["get", "kind"],
        [
          "airfield",
          "cemetery",
          "forest",
          "golf_course",
          "grass",
          "grassland",
          "military",
          "national_park",
          "nature_reserve",
          "naval_base",
          "park",
          "protected_area",
          "scrub",
          "wood"
        ],
        true,
        false
      ],
      "paint": {
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 6, 0, 11, 1],
        "fill-color": [
          "case",
          [
            "in",
            ["get", "kind"],
            [
              "literal",
              [
                "national_park",
                "park",
                "cemetery",
                "protected_area",
                "nature_reserve",
                "forest",
                "golf_course"
              ]
            ]
          ],
          "#1e4f4a",
          [
            "in",
            ["get", "kind"],
            ["literal", ["wood", "nature_reserve", "forest"]]
          ],
          "#3a8247",
          ["in", ["get", "kind"], ["literal", ["scrub", "grassland", "grass"]]],
          "#5d501a",
          ["in", ["get", "kind"], ["literal", ["glacier"]]],
          "rgba(255, 255, 255, 1)",
          ["in", ["get", "kind"], ["literal", ["sand"]]],
          "rgba(243, 201, 77, 1)",
          [
            "in",
            ["get", "kind"],
            ["literal", ["military", "naval_base", "airfield"]]
          ],
          "rgba(40, 99, 67, 1)",
          "rgba(230, 203, 177, 1)"
        ]
      }
    },
