{
  "version": 8,
  "name": "openstreetmap protomaps bio",
  "sources": {
    "openstreetmap-protomaps": {
      "type": "vector",
      "url": "https://v1.maps.black/openstreetmap-protomaps/{z}/{x}/{y}.pbf"
    }
  },
  "sprite": "https://v1.maps.black/styles/openstreetmap-protomaps/protomaps/bio/sprites/bio/sprites",
  "glyphs": "https://v1.maps.black/fonts-minimal/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {"background-color": "#dddddd"}
    },
    {
      "id": "earth",
      "type": "fill",
      "source": "openstreetmap-protomaps",
      "source-layer": "earth",
      "filter": [
        "match",
        ["geometry-type"],
        ["MultiPolygon", "Polygon"],
        true,
        false
      ],
      "paint": {"fill-color": "#ededed"}
    },
    {
      "id": "landuse_park",
      "type": "fill",
      "source": "openstreetmap-protomaps",
      "source-layer": "landuse",
      "filter": [
        "match",
        ["get", "kind"],
        [
          "airfield",
          "cemetery",
          "forest",
          "golf_course",
          "grass",
          "grassland",
          "military",
          "national_park",
          "nature_reserve",
          "naval_base",
          "park",
          "protected_area",
          "scrub",
          "wood"
        ],
        true,
        false
      ],
      "paint": {
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 6, 0, 11, 1],
        "fill-color": [
          "case",
          [
            "in",
            ["get", "kind"],
            [
              "literal",
              [
                "national_park",
                "park",
                "cemetery",
                "protected_area",
                "nature_reserve",
                "forest",
                "golf_course"
              ]
            ]
          ],
          "#bfc99c",
          [
            "in",
            ["get", "kind"],
            ["literal", ["wood", "nature_reserve", "forest"]]
          ],
          "#bfc99c",
          ["in", ["get", "kind"], ["literal", ["scrub", "grassland", "grass"]]],
          "#bfc99c",
          ["in", ["get", "kind"], ["literal", ["glacier"]]],
          "#ffffff",
          ["in", ["get", "kind"], ["literal", ["sand"]]],
          "#ebe7da",
          [
            "in",
            ["get", "kind"],
            ["literal", ["military", "naval_base", "airfield"]]
          ],
          "#ebe6ed",
          "#ededed"
        ]
      }
    },
    {
      "id": "landuse_urban_green",
      "type": "fill",
      "source": "openstreetmap-protomaps",
      "source-layer": "landuse",
      "filter": [
        "match",
        ["get", "kind"],
        ["allotments", "playground", "village_green"],
        true,
        false
      ],
      "paint": {"fill-color": "#bfc99c", "fill-opacity": 0.7}
    },
    {
      "id": "landuse_hospital",
