      "id": "background",
      "type": "background",
      "paint": {"background-color": "rgba(255, 228, 207, 1)"}
    },
    {
      "id": "earth",
      "type": "fill",
      "source": "openstreetmap-protomaps",
      "source-layer": "earth",
      "filter": [
        "match",
        ["geometry-type"],
        ["MultiPolygon", "Polygon"],
        true,
        false
      ],
      "paint": {"fill-color": "rgba(255, 195, 195, 1)"}
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "openstreetmap-protomaps",
      "source-layer": "landcover",
      "paint": {
        "fill-color": [
          "match",
          ["get", "kind"],
          "grassland",
          "rgba(147, 214, 182, 1)",
          "barren",
          "rgba(246, 204, 157, 1)",
          "urban_area",
          "rgba(255, 168, 168, 1)",
          "farmland",
          "rgba(159, 211, 159, 1)",
          "glacier",
          "rgba(251, 213, 213, 1)",
          "scrub",
          "rgba(191, 211, 160, 1)",
          "rgba(136, 210, 168, 1)"
        ],
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 5, 1, 7, 0]
      }
    },
    {
      "id": "landuse_park",
      "type": "fill",
      "source": "openstreetmap-protomaps",
      "source-layer": "landuse",
      "filter": [
        "match",
        ["get", "kind"],
        [
          "airfield",
          "cemetery",
          "forest",
          "golf_course",
          "grass",
          "grassland",
          "military",
          "national_park",
          "nature_reserve",
          "naval_base",
          "park",
          "protected_area",
          "scrub",
          "wood"
        ],
        true,
        false
      ],
      "paint": {
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 6, 0, 11, 1],
        "fill-color": [
          "case",
          [
            "in",
            ["get", "kind"],
            [
              "literal",
              [
                "national_park",
                "park",
                "cemetery",
                "protected_area",
                "nature_reserve",
                "forest",
                "golf_course"
              ]
            ]
          ],
          "#bbd285",
          [
            "in",
            ["get", "kind"],
            ["literal", ["wood", "nature_reserve", "forest"]]
          ],
          "#d7cc7f",
          ["in", ["get", "kind"], ["literal", ["scrub", "grassland", "grass"]]],
          "#d8d3a0",
          ["in", ["get", "kind"], ["literal", ["glacier"]]],
          "rgba(252, 218, 218, 1)",
          ["in", ["get", "kind"], ["literal", ["sand"]]],
          "rgba(245, 209, 169, 1)",
          [
            "in",
            ["get", "kind"],
            ["literal", ["military", "naval_base", "airfield"]]
          ],
          "rgba(134, 213, 161, 1)",
          "rgba(255, 195, 195, 1)"
