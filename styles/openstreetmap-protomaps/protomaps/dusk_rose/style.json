{
  "version": 8,
  "name": "openstreetmap protomaps dusk_rose",
  "sources": {
    "openstreetmap-protomaps": {
      "type": "vector",
      "url": "https://v1.maps.black/openstreetmap-protomaps/{z}/{x}/{y}.pbf"
    }
  },
  "sprite": "https://v1.maps.black/styles/openstreetmap-protomaps/protomaps/dusk_rose/sprites/dusk_rose/sprites",
  "glyphs": "https://v1.maps.black/fonts-minimal/{fontstack}/{range}.pbf",
